# Copia este archivo a .env y ajusta los valores (el .env no se sube a git).

# URL del backend FastAPI
VITE_API_URL=http://localhost:8000

# Pintor "en sesión" para el Panel del Pintor (aún no hay login).
# VITE_PAINTER_ID debe ser el UUID del pintor que ya existe en la tabla `pintores`.
VITE_PAINTER_ID=00000000-0000-0000-0000-000000000000
VITE_PAINTER_NAME=Kaelen Voss
